# Parked. GitHub only reads .yml and .yaml files in this folder, so while this
# file keeps the .disabled suffix the workflow never runs.
#
# To switch it back on, rename this file to ci.yml.

name: ci

on:
  push:
    branches: [main]
  pull_request:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - run: npm ci

      # package.json's build script runs `tsc --noEmit` before vite build,
      # so this covers both typecheck and bundle.
      - run: npm run build
